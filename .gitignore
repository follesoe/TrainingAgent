# Secrets - never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Personal training data. Keep the directory, not its contents.
data/*
!data/.gitkeep

# Vendored third-party reference data. Large, regenerable, and not ours to
# republish - see "Regenerating reference data" in CLAUDE.md. Keep the directory.
reference/*
!reference/.gitkeep

# Activity files (fit/tcx/gpx exports) are personal data
*.fit
*.tcx
*.gpx

# Machine-specific Claude Code settings (contains local paths)
.claude/settings.local.json

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

.DS_Store

# Third-party prompt kept locally, not published
bikefit/
