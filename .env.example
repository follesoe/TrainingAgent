# Copy to .env and fill in. .env is git-ignored.
#
# Get both values from https://intervals.icu/settings -> "Developer Settings".
# The API key is used as HTTP Basic auth: username "API_KEY", password = the key.

INTERVALS_API_KEY=

# Optional. "0" means "the athlete this API key belongs to", which is what you
# want for personal use. Set a real id (e.g. i123456) only to read another athlete.
INTERVALS_ATHLETE_ID=0

# Optional - only needed for the "training-agent zwift" commands.
#
# Zwift issues no personal API keys, so the unofficial API takes the account
# password itself. It is exchanged once for an OAuth token cached in
# data/.zwift-token.json; the password is not sent again until that expires.
# An account that signs in only through Apple/Google/Facebook has no password
# and cannot be used - set one at https://www.zwift.com/settings/account.
ZWIFT_EMAIL=
ZWIFT_PASSWORD=
